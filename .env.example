DB_DRIVER={ODBC Driver 17 for SQL Server}
QUERY_TIMEOUT_SECONDS=30

# ==========================================
# 1. HOSTS (IPs o Nombres)
# ==========================================
SERVER_A_PROD_HOST=ip_o_host_servidor_1
SERVER_B_PROD_HOST=ip_o_host_servidor_2

# ==========================================
# 2. MAPEO DE BASES DE DATOS A SERVIDORES
# ==========================================
# --- Servidor A ---
MAP_MIPRIMERABD_SERVER=SERVER_A_PROD
MAP_OTRABD_SERVER=SERVER_A_PROD

# --- Servidor B ---
MAP_MISEGUNDABD_SERVER=SERVER_B_PROD

# ==========================================
# 3. CREDENCIALES (Recomendado: Solo Lectura)
# ==========================================
# --- Servidor A ---
CRED_MIPRIMERABD_USER=usuario_lectura_1
CRED_MIPRIMERABD_PASSWORD=password_aqui

CRED_OTRABD_USER=usuario_lectura_2
CRED_OTRABD_PASSWORD=password_aqui

# --- Servidor B ---
CRED_MISEGUNDABD_USER=usuario_lectura_3
CRED_MISEGUNDABD_PASSWORD=password_aqui

# ==========================================
# 4. BASES DE DATOS REPETIDAS EN MULTIPLES SERVIDORES 
#    (Requieren que el usuario pase el parámetro 'servidor' a la herramienta)
# ==========================================
MAP_DBCOMUN_A_SERVER=SERVER_A_PROD
MAP_DBCOMUN_B_SERVER=SERVER_B_PROD

CRED_DBCOMUN_A_USER=usuario_comun_a
CRED_DBCOMUN_A_PASSWORD=password_aqui

CRED_DBCOMUN_B_USER=usuario_comun_b
CRED_DBCOMUN_B_PASSWORD=password_aqui
